generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                   String              @id @default(cuid())
  businessName         String
  ownerName            String
  personalFunds        Float               @default(0)
  personalCashOnHand   Float               @default(0)
  businessFunds        Float               @default(0)
  reservedBusinessFunds Float              @default(0)
  cashOnHand           Float               @default(0)
  reservedCashFunds    Float               @default(0)
  glockEnabled         Boolean             @default(false)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  products             Product[]
  transactions         Transaction[]
  connections          ConnectedBusiness[]
  reservedPlans        ReservedPlan[]
}

model Product {
  id                         String         @id @default(cuid())
  merchantId                 String
  merchant                   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name                       String
  category                   String
  subcategory                String
  stock                      Int            @default(0)
  sellingPrice               Float
  costPrice                  Float
  planningMethod             String         @default("FORECAST_AI")
  lowStockThreshold          Int            @default(5)
  isVisibleToConnectedBusinesses Boolean    @default(false)
  vendorAvailableQuantity    Int            @default(0)
  vendorPrice                Float?
  dtiSrpProfileKey           String?
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  items                      TransactionItem[]
}

model Transaction {
  id            String            @id @default(cuid())
  merchantId    String
  merchant      Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  totalAmount   Float
  paymentMethod String            @default("GCASH")
  paymentStatus String            @default("PENDING")
  receiptCode   String            @unique
  cashReceived  Float?
  changeGiven   Float?
  profitAmount  Float?
  paidAt        DateTime?
  createdAt     DateTime          @default(now())
  items         TransactionItem[]
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String
  quantity      Int
  unitPrice     Float
  subtotal      Float
}

model ConnectedBusiness {
  id               String           @id @default(cuid())
  merchantId       String
  merchant         Merchant         @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  connectedMerchantId String
  status           String           @default("PENDING")
  relationshipType String           @default("BOTH")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ReservedPlan {
  id                   String             @id @default(cuid())
  merchantId           String
  merchant             Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  source               String
  cardType             String
  totalCost            Float
  status               String             @default("DRAFT")
  createdAt            DateTime           @default(now())
  items                ReservedPlanItem[]
}

model ReservedPlanItem {
  id             String       @id @default(cuid())
  reservedPlanId String
  reservedPlan   ReservedPlan @relation(fields: [reservedPlanId], references: [id], onDelete: Cascade)
  productName    String
  quantity       Int
  unitPrice      Float
  subtotal       Float
  supplierName   String?
}

model RadarTransaction {
  id                 String   @id @default(cuid())
  area               String
  productName        String
  category           String
  quantity           Int
  purchaseTime       DateTime
  anonymizedMerchantType String
}
