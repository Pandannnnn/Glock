DATABASE_URL="file:./dev.db"

# Optional: the prototype works with deterministic fallback copy when absent.
GEMINI_API_KEY=""

# Optional model override. Gemini 3.5 Flash-Lite is used by default.
GEMINI_MODEL="gemini-3.5-flash-lite"

# Used when the primary model is unavailable or busy.
GEMINI_FALLBACK_MODEL="gemini-3.6-flash"
